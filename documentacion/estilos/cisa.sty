% ── Historias de usuario ─────────────────────────────────────────────
% \historiaUsuario{ID}{Título}{Historia}{Prioridad}{Criterios de aceptación}
%   Ej.: \historiaUsuario{HU-01}{Consultar unidades dentro}
%          {Como operador del patio, quiero..., para...}{Alta}
%          {\begin{itemize}[nosep,leftmargin=*] \item ... \end{itemize}}
% Genera una tabla numerada con etiqueta hu:ID (p. ej. \ref{hu:HU-01}).
\newcommand{\historiaUsuario}[5]{%
  \begin{table}[H]
    \centering\small
    % Las listas dentro de la celda empiezan a la altura de la prioridad.
    \setlist[itemize]{nosep, leftmargin=*,
                      before=\vspace{-0.75\baselineskip},
                      after=\vspace{-0.35\baselineskip}}%
    \begin{tabular}{@{}L{2.1cm}L{11.5cm}@{}}
      \toprule
      \textbf{ID} & \textbf{Historia de usuario --- #2} \\
      \midrule
      \textbf{#1} & #3 \\
      \midrule
      \textbf{Prioridad} & \textbf{Criterios de aceptación} \\
      \midrule
      #4 & #5 \\
      \bottomrule
    \end{tabular}
    \caption{Historia de usuario --- #2.}
    \label{hu:#1}
  \end{table}%
}
