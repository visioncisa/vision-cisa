% =====================================================================
%  cisa.sty — Estilo único de la documentación de SARU
%  ---------------------------------------------------------------------
%  Aquí van TODOS los paquetes, colores, cajas y comandos propios.
%  Los capítulos NO cargan paquetes: solo usan lo que define este archivo.
%  Si necesitas un paquete nuevo, agrégalo aquí (y avisa en el README).
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilos/cisa}[2026/11/13 v1.0 Estilo de la documentación CISA]

% ── Idioma y tipografía ──────────────────────────────────────────────
\RequirePackage{lmodern}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[spanish,es-tabla,es-nodecimaldot,es-noshorthands]{babel}
% La bibliografía se titula "Referencias" (como en los reportes del equipo).
\addto\captionsspanish{\renewcommand{\bibname}{Referencias}}

% ── Página ───────────────────────────────────────────────────────────
\RequirePackage[a4paper,top=3cm,bottom=3cm,left=2.8cm,right=2.8cm,
                headheight=15pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\nouppercase{\leftmark}}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

% ── Tablas, listas y figuras ─────────────────────────────────────────
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{graphicx}
\RequirePackage{xcolor}

\captionsetup{
  font=small,
  labelfont=bf,
  justification=raggedright,
  singlelinecheck=false
}
\setlist{itemsep=2pt,topsep=4pt,parsep=0pt}

% Columnas de tabla alineadas a la izquierda: en columnas angostas el texto
% justificado deja huecos enormes. Uso: \begin{longtable}{@{}L{4cm}L{8cm}@{}}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}

% ── Matemáticas ──────────────────────────────────────────────────────
\RequirePackage{amsmath}
\RequirePackage{amssymb}

% ── Código ───────────────────────────────────────────────────────────
\RequirePackage{listings}
\lstdefinestyle{cisa}{
  backgroundcolor=\color{grisFondo},
  basicstyle=\ttfamily\footnotesize,
  commentstyle=\color{verdeComentario}\itshape,
  keywordstyle=\color{azulCISA}\bfseries,
  stringstyle=\color{naranja},
  numberstyle=\tiny\color{grisTexto},
  numbers=left,
  numbersep=6pt,
  frame=single,
  rulecolor=\color{grisBorde},
  breaklines=true,
  breakatwhitespace=false,
  postbreak=\mbox{\textcolor{grisTexto}{$\hookrightarrow$}\space},
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  tabsize=4,
  upquote=true,
  captionpos=b,
  literate=%
    {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
    {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
    {ñ}{{\~n}}1 {Ñ}{{\~N}}1 {ü}{{\"u}}1 {Ü}{{\"U}}1
    {¿}{{?`}}1 {¡}{{!`}}1
    {→}{{$\rightarrow$}}1 {←}{{$\leftarrow$}}1
    {─}{{-}}1 {│}{{|}}1 {├}{{|}}1 {└}{{+}}1 {┌}{{+}}1 {┐}{{+}}1 {┘}{{+}}1
}
\lstset{style=cisa}
% Uso: \begin{lstlisting}[language=Python, caption={...}, label={lst:...}]
% Para rutas y nombres de archivo usa \path{...} (del paquete url, que carga
% hyperref): respeta los guiones bajos y permite cortar la línea en las barras.
% Para código corto en línea usa \texttt{...} y escapa los guiones bajos: \_
\newcommand{\codigo}[1]{\texttt{#1}}

