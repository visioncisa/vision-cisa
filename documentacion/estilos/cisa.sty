}

\newtcolorbox{aviso}[1][]{
  enhanced, breakable,
  colback=ambarFondo, colframe=ambarBorde,
  boxrule=0.6pt, arc=1.5mm,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\bfseries\small,
  title={Aviso},
  #1
}

\newtcolorbox{peligro}[1][]{
  enhanced, breakable,
  colback=rojoFondo, colframe=rojoBorde,
