% ── Figuras ──────────────────────────────────────────────────────────
% Todas las imágenes viven en documentacion/figuras/<carpeta-del-capitulo>/.
\graphicspath{{figuras/}}

% \figura[ancho]{carpeta/archivo.png}{Pie de figura}{etiqueta}
%   Ej.: \figura[0.8\linewidth]{02_arquitectura/flujo.png}{Flujo general}{fig:flujo}
\newcommand{\figura}[4][\linewidth]{%
  \begin{figure}[htbp]
    \centering
    \includegraphics[width=#1]{#2}
    \caption{#3}
    \label{#4}
  \end{figure}%
}

% Marcador para una figura que todavía no existe.
% \figuraPendiente{carpeta/archivo.png}{Qué debe mostrar}{etiqueta}
% Compila sin la imagen y deja un recuadro visible para no olvidarla.
\newcommand{\figuraPendiente}[3]{%
  \begin{figure}[htbp]
    \centering
    \begin{tcolorbox}[enhanced, width=0.85\linewidth, colback=white,
                      frame hidden, arc=1.5mm,
                      borderline={0.6pt}{0pt}{grisTexto, dashed},
                      left=8pt, right=8pt, top=8pt, bottom=8pt]
      \centering
      {\bfseries\small Figura pendiente}\\[4pt]
      {\footnotesize #2}\\[6pt]
      {\scriptsize\color{grisTexto} Guarda la imagen en
       \texttt{figuras/#1} y sustituye este recuadro por
       \texttt{\textbackslash figura\{#1\}\{\ldots\}\{#3\}}}
    \end{tcolorbox}
    \caption{#2 \textit{(figura pendiente)}}
    \label{#3}
  \end{figure}%
}

