% ── Cajas de aviso ───────────────────────────────────────────────────
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

\newtcolorbox{nota}[1][]{
  enhanced, breakable,
  colback=azulClaro, colframe=azulCISA,
  boxrule=0.6pt, arc=1.5mm,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\bfseries\small,
