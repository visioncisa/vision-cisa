# =====================================================================
# CISA — configuración por patio. Copiar a .env y llenar.
# El .env NUNCA va en la imagen de Docker ni se comparte (tiene contraseñas).
# =====================================================================

# ── Cámara ───────────────────────────────────────────────────────────
# RTSP_URL: la que usa el sistema. Cámara (rtsp://...) o video .mp4 (modo prueba).
# Se cambia con: python3 scripts/fuente.py camara | video
RTSP_URL=rtsp://USUARIO:CONTRASEÑA@192.168.10.2:554/cam/realmonitor?channel=1&subtype=0
RTSP_URL_CAMARA=rtsp://USUARIO:CONTRASEÑA@192.168.10.2:554/cam/realmonitor?channel=1&subtype=0
RTSP_URL_VIDEO=/home/jetson/Documents/Jetson8/cam1_grabacion/cam1_20260901_100804.mp4
# RTSP_URL_CAM2=                     # opcional: botón "Cam 2"
# CAM_BACKEND=ffmpeg                 # opcional: sin decodificación por hardware

# ── Modelos (rutas relativas a la carpeta del proyecto) ──────────────
MODEL_PATH=modelos/engine_nx/modelo_vista_v3.engine
DIGITS_MODEL_PATH=modelos/engine_nx/modelo_digitos_v3.engine
AUTOBUS_MODEL_PATH=modelos/engine_nx/bus_v3.engine

# ── Rendimiento ──────────────────────────────────────────────────────
YOLO_FPS_MAX=15                      # M1 (autobús). 0 = sin límite; menos fps = menos consumo
M2_FPS_MAX=5                         # M2+M3 (número). Subirlo si se pierden lecturas; bajarlo si se calienta
# CROPS_CADA_SEG=1                   # crops de zona para dataset: 1 cada N seg por camión (0 = todos)

# ── Línea virtual y registro ─────────────────────────────────────────
LINEA_P1=280,250
LINEA_P2=500,479
LADO_ENTRADA=izquierda
MANIOBRA_SEG=20
DEBOUNCE_SEG=60
ESPERA_FIN_SEG=2                     # seg sin ver al camión = ya pasó
ESPERA_MAX_SEG=25                    # máximo a esperar antes de decidir (nunca menos que MANIOBRA_SEG+1)
MARGEN_LINEA_PX=30                   # px alrededor de la línea donde el lado no cambia
VOTOS_FUERA_PADRON=4                 # lecturas iguales para registrar un número que no está en el padrón
FOTOS_POR_AVISO=3                    # fotos por aviso (las mejores, de momentos distintos)
FOTOS_SEPARACION_SEG=1.0             # segundos mínimos entre una foto y otra
ID_PUERTA=1

# ── Telegram ─────────────────────────────────────────────────────────
TG_TOKEN=
TG_CHAT_ID=
TG_VALIDADOR_IDS=
SIN_TELEGRAM=1                       # 1 = no manda nada (pruebas)

# ── Gemini (revisa la foto antes de registrar) ───────────────────────
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# VALIDAR_CON_GEMINI=1               # por defecto sigue a Telegram; 1 = prenderlo sin Telegram

# ── WhatsApp (servicio cisa-whatsapp) ────────────────────────────────
# Número que recibe los mismos avisos del grupo, con lada: 52 + 10 dígitos.
# Vacío = WhatsApp apagado. La primera vez: docker compose logs -f cisa-whatsapp y escanear el QR.
WHATSAPP_NUMERO=
# Número del teléfono que MANDA (52 + 10 dígitos): si está, se vincula con código de 8 letras en vez de QR.
# WHATSAPP_EMISOR=
# WHATSAPP_URL=http://127.0.0.1:5002

# ── Monitor de cámaras (scripts/check_tailscale.py) ──────────────────
# MONITOR_TG_TOKEN=                  # si falta, usa TG_TOKEN
# MONITOR_TG_CHAT_ID=                # si falta, usa TG_CHAT_ID
# MONITOR_CAMARAS=192.168.10.2,192.168.10.4

# ── Carpetas ─────────────────────────────────────────────────────────
DB_PATH=datos/detecciones.db
FRAMES_DIR=/home/jetson/Documents/Jetson8/cisa_frames
CROPS_DIR=/home/jetson/Documents/Jetson8/crops_dataset
GRABACIONES_DIR=/home/jetson/Documents/Jetson8/grabaciones
# PADRON_PATH=padron.csv

# ── Web ──────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
# MJPEG_FPS=10                       # video en vivo: cuadros por segundo
# MJPEG_ANCHO=960                    # video en vivo: ancho en px
# LISTA_DETECCIONES=10               # detecciones en la lista en vivo
